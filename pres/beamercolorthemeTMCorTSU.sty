\ProvidesPackage{beamerthemeTMCorTSU}
\mode<presentation>
\definecolor{MainBlue}{RGB}{0,114,188} % #0072BC
\definecolor{LightBlue}{RGB}{204,229,255} % #cce5ff
\definecolor{DarkBlue}{RGB}{0,71,130} % #004782
\definecolor{AccentOrange}{RGB}{255,127,0} % #ff7f00
\definecolor{AccentGreen}{RGB}{0,153,68} % #009944

\setbeamercolor{block title}{use=structure,fg=MainBlue,bg=MainBlue!20!white}
\setbeamercolor{block title alerted}{use=alerted text,fg=AccentOrange,bg=AccentOrange!20!white}
\setbeamercolor{block title example}{use=example text,fg=AccentGreen,bg=AccentGreen!20!white}

\setbeamercolor{block body}{parent=normal text,use=block title,bg=block title.bg!50!white}
\setbeamercolor{block body alerted}{parent=normal text,use=block title alerted,bg=block title alerted.bg!50!white}
\setbeamercolor{block body example}{parent=normal text,use=block title example,bg=block title example.bg!50!white}

\setbeamercolor*{palette primary}{use=structure,fg=white,bg=MainBlue}
\setbeamercolor*{palette secondary}{use=structure,fg=white,bg=structure.fg!60!white}
\setbeamercolor*{palette tertiary}{use=structure,fg=white,bg=structure.fg!90!white}
\setbeamercolor*{palette quaternary}{fg=white,bg=black}

\setbeamercolor{structure}{fg=MainBlue}
\mode
<all>

